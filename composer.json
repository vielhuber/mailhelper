{
    "name": "vielhuber/mailhelper",
    "description": "Lightweight email integration layer.",
    "require": {
        "php": ">=8.1",
        "php-mcp/server": "^3.3",
        "phpmailer/phpmailer": "^6.0 || ^7.0",
        "webklex/php-imap": "^6.2.0",
        "monolog/monolog": "^3.10.0",
        "illuminate/pagination": "^13.20.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "vielhuber\\mailhelper\\": "src/"
        }
    },
    "bin": [
        "src/mailhelper.php",
        "src/mcp-server.php"
    ],
    "require-dev": {
        "phpunit/phpunit": "^13"
    }
}